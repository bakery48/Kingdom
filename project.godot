; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can always edit it manually in a text editor.
;
; If the file is missing, the engine picks default values.
; The available presets and their defaults are listed in:
; https://github.com/godotengine/godot/blob/master/core/core_settings.cpp

config_version=5

[application]

config/name="アルデン家の年代記"
config/description="一族の年代記を紡ぐ、世代継承ファンタジーRPG"
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/data/GameData.gd"
SaveManager="*res://scripts/data/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="forward_plus"
