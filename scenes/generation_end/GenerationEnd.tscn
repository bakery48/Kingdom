custom_minimum_size = Vector2(250, 0)

[node name="ConfirmButton" type="Button" parent="Panel/VBox"]
text = "継承を確定して次の世代へ"

[node name="SkipButton" type="Button" parent="Panel/VBox"]
text = "何も継承せず次へ"

[connection signal="pressed" from="Panel/VBox/ConfirmButton" to="." method="_on_confirm_button_pressed"]
[connection signal="pressed" from="Panel/VBox/SkipButton" to="." method="_on_skip_button_pressed"]
