[ext_resource type="Script" path="res://scenes/generation_end/GenerationEnd.gd" id="1_genend01"]

[node name="GenerationEnd" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_genend01")

[node name="Panel" type="PanelContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Panel"]

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
text = "── 世代の終焉と継承 ──"
theme_override_font_sizes/font_size = 22

[node name="DeceasedLabel" type="Label" parent="Panel/VBox"]
text = "故人情報を読み込み中..."

[node name="SkillsSection" type="VBoxContainer" parent="Panel/VBox"]

[node name="SectionTitle" type="Label" parent="Panel/VBox/SkillsSection"]
text = "【継承するスキルを選ぶ】（最大3つ）"

[node name="SkillsContainer" type="VBoxContainer" parent="Panel/VBox/SkillsSection"]

[node name="ItemsSection" type="VBoxContainer" parent="Panel/VBox"]

[node name="SectionTitle" type="Label" parent="Panel/VBox/ItemsSection"]
text = "【継承するアイテムを選ぶ】（最大2つ）"

[node name="ItemsContainer" type="VBoxContainer" parent="Panel/VBox/ItemsSection"]

[node name="SelectionInfo" type="VBoxContainer" parent="Panel/VBox"]

[node name="SelectedSkillsLabel" type="Label" parent="Panel/VBox/SelectionInfo"]
text = "継承スキル: 0/3 選択"

[node name="SelectedItemsLabel" type="Label" parent="Panel/VBox/SelectionInfo"]
text = "継承アイテム: 0/2 選択"

[node name="HeirSection" type="HBoxContainer" parent="Panel/VBox"]

[node name="Label" type="Label" parent="Panel/VBox/HeirSection"]
