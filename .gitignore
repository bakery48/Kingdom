# Godot 4 .gitignore

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/IDE files
.DS_Store
Thumbs.db
*.swp
*.swo

# Build output
builds/
dist/

# User-specific editor settings
.godot/
